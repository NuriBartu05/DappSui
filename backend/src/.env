# Sui Network Configuration
SUI_NODE_URL=https://fullnode.testnet.sui.io:443
NETWORK=testnet

# Enoki Gas Station Configuration
# Get your API key from: https://portal.enoki.mystenlabs.com/
ENOKI_API_KEY=your_enoki_api_key_here
ENOKI_API_URL=https://api.enoki.mystenlabs.com

# Treasury Configuration
# This is where service fees (in USDC) will be sent
TREASURY_ADDRESS=0x_your_treasury_address_here

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Service Fee Configuration
# Fee in basis points (30 = 0.3%)
SERVICE_FEE_BPS=30

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
